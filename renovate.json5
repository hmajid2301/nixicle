{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track stable TUIOS releases in the source and generated flake",
      "managerFilePatterns": [
        "/^flake\\.nix$/",
        "/^modules/aspects/cli/multiplexers/tuios/default\\.nix$/"
      ],
      "matchStrings": [
        "(?:flake-file\\.inputs\\.)?tuios\\.url = \"github:Gaurav-Gosain/tuios/(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)\";"
      ],
      "depNameTemplate": "tuios",
      "packageNameTemplate": "Gaurav-Gosain/tuios",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "🤖 Dependency Updates",
  "suppressNotifications": ["prIgnoreNotification"],
  "rebaseWhen": "conflicted",
  "schedule": [],
  "timezone": "Europe/London",
  "prConcurrentLimit": 10,
  "prHourlyLimit": 0,
  "labels": ["dependencies", "renovate"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [],
    "commitMessageAction": "chore",
    "commitMessageTopic": "Update flake.lock"
  },
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "separateMinorPatch": false,
  "packageRules": [
    {
      "description": "Update both TUIOS declarations and refresh their lock entry together",
      "matchManagers": ["custom.regex"],
      "matchDepNames": ["tuios"],
      "groupName": "tuios releases",
      "automerge": true,
      "platformAutomerge": false,
      "ignoreTests": false,
      "postUpgradeTasks": {
        "commands": [
          "nix --extra-experimental-features 'nix-command flakes' flake update tuios"
        ],
        "installTools": { "nix": {} },
        "fileFilters": ["flake.lock"],
        "executionMode": "branch"
      }
    },
    {
      "description": "Group all non-major Nix flake dependencies",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "nix flake dependencies (non-major)",
      "automerge": false
    },
    {
      "description": "Separate major Nix flake updates",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["major"],
      "groupName": "nix flake dependencies (major)",
      "automerge": false
    }
  ]
}
