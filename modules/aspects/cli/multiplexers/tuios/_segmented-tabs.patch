@@ -0,0 +1,99 @@
+package app
+
+import (
+	"charm.land/lipgloss/v2"
+	"github.com/Gaurav-Gosain/tuios/internal/config"
+	"image/color"
+	"testing"
+	"tuios.dev/vt"
+)
+
+func TestSegmentedDockColorsFollowWorkspaceNotVisibleOrder(t *testing.T) {
+	m := pillCapsOS(t, 160, map[int]string{1: "code", 2: "shell", 3: "review", 4: "docs"}, 1, 2, 3, 4)
+	m.Settings.DockWorkspaceTabFormat = "{icon}  {name}"
+	m.UserConfig = &config.UserConfig{}
+	m.UserConfig.Dock.Tabs.Style = "segmented"
+	if err := config.SetLookValue(m.UserConfig, "dock.tabs.cap_colors", `["#b4befe","#cba6f7","#a6e3a1"]`); err != nil {
+		t.Fatal(err)
+	}
+	for _, active := range []int{1, 2} {
+		m.CurrentWorkspace = active
+		layout := m.CalculateDockLayout()
+		strip := layout.WorkspaceStrip
+		for _, omitFirst := range []bool{false, true} {
+			shown := strip
+			if omitFirst {
+				shown.Pills = shown.Pills[1:]
+			}
+			drawn := m.renderDockWorkspaceStrip(shown, 0)
+			term := vt.New(200, 1)
+			_, _ = term.Write([]byte(drawn))
+			wants := map[int]color.Color{1: lipgloss.Color("#b4befe"), 2: lipgloss.Color("#cba6f7"), 3: lipgloss.Color("#a6e3a1"), 4: lipgloss.Color("#b4befe")}
+			for _, hit := range m.dockWorkspaceHits {
+				if hit.Workspace == 0 {
+					continue
+				}
+				got := term.CellAt(hit.X0+2, 0).Style.Bg
+				want := wants[hit.Workspace]
+				if got == nil || !sameDockColor(got, want) {
+					t.Errorf("workspace %d cap = %v want %v", hit.Workspace, got, want)
+				}
+				label := term.CellAt(hit.X1-3, 0).Style.Bg
+				if !sameDockColor(label, m.groundUI().Panel) {
+					t.Errorf("workspace %d lost dark label", hit.Workspace)
+				}
+			}
+		}
+	}
+}
+
+func TestSegmentedDockInvalidCapColorFallsBackAndOtherStylesIgnoreColors(t *testing.T) {
+	for _, style := range []string{"segmented", "pill", "flat"} {
+		m := pillCapsOS(t, 160, map[int]string{1: "code"}, 1)
+		m.Settings.DockWorkspaceTabFormat = "{icon}  {name}"
+		m.UserConfig = &config.UserConfig{}
+		m.UserConfig.Dock.Tabs.Style = style
+		layout := m.CalculateDockLayout()
+		want := m.renderDockWorkspaceStrip(layout.WorkspaceStrip, 0)
+		colors := []string{"#a6e3a1"}
+		if style == "segmented" {
+			colors = []string{"not-a-colour"}
+		}
+		m.UserConfig.Dock.Tabs.CapColors = colors
+		if got := m.renderDockWorkspaceStrip(layout.WorkspaceStrip, 0); got != want {
+			t.Errorf("%s changed when cap colours should be ignored", style)
+		}
+	}
+}
+
+func TestSegmentedDockCapColorsDoNotTintFallbackPills(t *testing.T) {
+	for _, mode := range []string{"ascii", "no-caps", "one-token"} {
+		m := pillCapsOS(t, 160, map[int]string{1: "code"}, 1)
+		m.Settings.DockWorkspaceTabFormat = "{icon}  {name}"
+		switch mode {
+		case "ascii":
+			m.Settings.UseASCIIOnly = true
+		case "no-caps":
+			m.Settings.DockPillCaps = false
+		case "one-token":
+			m.Settings.DockWorkspaceTabFormat = "{name}"
+		}
+		m.UserConfig = &config.UserConfig{}
+		m.UserConfig.Dock.Tabs.Style = "segmented"
+		layout := m.CalculateDockLayout()
+		want := m.renderDockWorkspaceStrip(layout.WorkspaceStrip, 0)
+		m.UserConfig.Dock.Tabs.CapColors = []string{"#a6e3a1"}
+		if got := m.renderDockWorkspaceStrip(layout.WorkspaceStrip, 0); got != want {
+			t.Errorf("%s fallback pill was tinted by cap colours", mode)
+		}
+	}
+}
+
+func sameDockColor(a, b color.Color) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+	ar, ag, ab, aa := a.RGBA()
+	br, bg, bb, ba := b.RGBA()
+	return ar == br && ag == bg && ab == bb && aa == ba
+}
