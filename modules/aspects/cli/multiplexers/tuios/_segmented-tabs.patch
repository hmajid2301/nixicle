diff --git a/internal/app/command_palette_density_test.go b/internal/app/command_palette_density_test.go
new file mode 100644
index 0000000..dac20ed
--- /dev/null
+++ b/internal/app/command_palette_density_test.go
@@ -0,0 +1,124 @@
+package app
+
+import (
+	"fmt"
+	"reflect"
+	"strings"
+	"testing"
+
+	"charm.land/lipgloss/v2"
+	"github.com/Gaurav-Gosain/tuios/internal/config"
+	"github.com/Gaurav-Gosain/tuios/internal/overlay"
+	"github.com/charmbracelet/x/ansi"
+	"github.com/pelletier/go-toml/v2"
+)
+
+func TestPaletteCompactDensityUnchanged(t *testing.T) {
+	m := newNarrowOS(t, 80, 30)
+	m.UserConfig = config.DefaultConfig()
+	m.PaletteItems = []CommandPaletteItem{{Name: "Entry", Category: "Group"}}
+	m.UserConfig.Appearance.CommandPaletteDensity = ""
+	before, beforeGeo, beforeHits := m.renderCommandPalette()
+	m.UserConfig.Appearance.CommandPaletteDensity = "compact"
+	after, afterGeo, afterHits := m.renderCommandPalette()
+	if before != after || !reflect.DeepEqual(beforeGeo, afterGeo) || !reflect.DeepEqual(beforeHits, afterHits) {
+		t.Fatal("explicit compact changed default rendering or hit geometry")
+	}
+}
+
+func TestPaletteRoomyEmptyAndPageFit(t *testing.T) {
+	for _, width := range []int{24, 80} {
+		for _, height := range []int{9, 12, 18, 40} {
+			m := newNarrowOS(t, width, height)
+			m.UserConfig = config.DefaultConfig()
+			m.UserConfig.Appearance.CommandPaletteDensity = "roomy"
+			m.PaletteItems = []CommandPaletteItem{}
+			content, _, hits := m.renderCommandPalette()
+			panelWidth, _, hints := m.paletteLayout()
+			limit := max(m.panelRoomHeight(), panelChrome(2, panelWidth, nil, hints)+minPanelRows)
+			if lipgloss.Height(content) > limit || len(hits) != 0 {
+				t.Fatalf("empty %dx%d: height=%d hits=%d", width, height, lipgloss.Height(content), len(hits))
+			}
+			for i := range 24 {
+				m.PaletteItems = append(m.PaletteItems, CommandPaletteItem{Name: fmt.Sprintf("Entry %02d", i), Category: "Group"})
+			}
+			m.CommandPaletteQuery = "Entry"
+			_, _, hits = m.renderCommandPalette()
+			if m.PalettePageRows() != len(hits) {
+				t.Fatalf("page step=%d, visible commands=%d", m.PalettePageRows(), len(hits))
+			}
+			m.PaletteMove(m.PalettePageRows())
+			_, _, hits = m.renderCommandPalette()
+			found := false
+			for _, hit := range hits {
+				found = found || hit.Idx == m.CommandPaletteSelected
+			}
+			if !found {
+				t.Fatal("page navigation hid the selection")
+			}
+		}
+	}
+}
+
+func TestPaletteDensityRendering(t *testing.T) {
+	for _, density := range []string{"", "compact", "roomy", "invalid"} {
+		for _, grouped := range []bool{false, true} {
+			for _, height := range []int{9, 10, 12, 18, 40} {
+				t.Run(fmt.Sprintf("%s/grouped=%v/h=%d", density, grouped, height), func(t *testing.T) {
+					m := newNarrowOS(t, 80, height)
+					m.UserConfig = config.DefaultConfig()
+					if err := toml.Unmarshal([]byte(fmt.Sprintf("[appearance]\npalette_density = %q\n", density)), m.UserConfig); err != nil {
+						t.Fatal(err)
+					}
+					oldPadding := m.UserConfig.Appearance.PanelPadding
+					overlay.SetPanelPadding(1)
+					t.Cleanup(func() { overlay.SetPanelPadding(oldPadding) })
+					m.PaletteItems = nil
+					for i := range 24 {
+						m.PaletteItems = append(m.PaletteItems, CommandPaletteItem{Name: fmt.Sprintf("Entry %02d", i), Category: fmt.Sprintf("Group %d", i/4)})
+					}
+					if !grouped {
+						m.CommandPaletteQuery = "Entry"
+					}
+					stride := 1
+					if density == "roomy" {
+						stride = 2
+					}
+					for step := range 48 {
+						content, geo, hits := m.renderCommandPalette()
+						panelWidth, _, hints := m.paletteLayout()
+						limit := max(m.panelRoomHeight(), panelChrome(2, panelWidth, nil, hints)+minPanelRows)
+						if lipgloss.Height(content) > limit {
+							t.Fatalf("panel height %d exceeds fitted limit %d", lipgloss.Height(content), limit)
+						}
+						rendered := strings.Split(ansi.Strip(content), "\n")
+						selected := false
+						for _, hit := range hits {
+							if hit.Rect.Y1-hit.Rect.Y0 != stride {
+								t.Fatalf("row height = %d, want %d", hit.Rect.Y1-hit.Rect.Y0, stride)
+							}
+							if !strings.Contains(rendered[hit.Rect.Y0], m.filteredPaletteItems()[hit.Idx].Name) {
+								t.Fatalf("hit %d misses rendered name: %q", hit.Idx, rendered[hit.Rect.Y0])
+							}
+							if hit.Rect.Y1 > geo.Height-1 {
+								t.Fatalf("hit extends past body: %+v, %+v", hit, geo)
+							}
+							if stride == 2 && strings.TrimSpace(rendered[hit.Rect.Y0+1]) != "" {
+								t.Fatalf("roomy row has no blank spacing: %q", rendered[hit.Rect.Y0+1])
+							}
+							selected = selected || hit.Idx == m.CommandPaletteSelected
+						}
+						if !selected {
+							t.Fatalf("selection %d not visible", m.CommandPaletteSelected)
+						}
+						delta := 1
+						if step >= 24 {
+							delta = -1
+						}
+						m.PaletteMove(delta)
+					}
+				})
+			}
+		}
+	}
+}
