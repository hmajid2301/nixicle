+package app
+
+import (
+	"testing"
+
+	"github.com/Gaurav-Gosain/tuios/internal/config"
+	"github.com/Gaurav-Gosain/tuios/internal/session"
+)
+
+func TestSidebarDetachedLeavesSessionRailAttached(t *testing.T) {
+	m := detachedRail(t, 120, 40, "left")
+	m.UserConfig = config.DefaultConfig()
+	on := true
+	m.UserConfig.Appearance.Sidebar.Left = &config.SidebarEdgeConfig{Enabled: &on, Session: "tools"}
+	m.DaemonClient = &session.TUIClient{}
+	if !m.sidebarSessionVisible(sidebarLeft) {
+		t.Fatal("session rail not visible")
+	}
+	g := m.railGeometry()
+	if g.Detached || g.Frame != g.Band {
+		t.Fatal("detached regular frame shifted full-band session rail")
+	}
+}
