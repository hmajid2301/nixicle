new file mode 100644
index 0000000..a403954
--- /dev/null
+++ b/internal/app/sidebar_detached_scroll_test.go
@@ -0,0 +1,112 @@
+package app
+
+import (
+	"strconv"
+	"strings"
+	"testing"
+
+	"charm.land/lipgloss/v2"
+	"github.com/Gaurav-Gosain/tuios/internal/terminal"
+	"github.com/charmbracelet/x/ansi"
+)
+
+func TestSidebarDetachedScrollAndFooterRows(t *testing.T) {
+	for _, side := range []string{"left", "right"} {
+		t.Run(side, func(t *testing.T) {
+			m := detachedRail(t, 120, 20, side)
+			m.Settings.SidebarSections = "terminals"
+			m.Windows = nil
+			for i := range 40 {
+				m.Windows = append(m.Windows, &terminal.Window{ID: strconv.Itoa(i), CustomName: "terminal", Workspace: 1})
+			}
+			lines, _ := m.sidebarPanelLines()
+			g := m.railGeometry()
+			band := m.sidebarSectionY[sidebarSectionTerminals]
+			if band[0] < g.Content.Y || band[1] > g.Content.Y+g.Content.H {
+				t.Fatalf("scroll band outside inner content: %v", band)
+			}
+			thumb := m.Settings.GetRailScrollThumbBeside(m.Settings.GetWindowBorderLeft())
+			found := false
+			for i, line := range lines {
+				raw := ansi.Strip(line)
+				if !strings.Contains(raw, thumb) {
+					continue
+				}
+				found = true
+				y := g.Frame.Y + i
+				if y < band[0] || y >= band[1] {
+					t.Fatal("thumb outside scroll band")
+				}
+				if side == "left" && !strings.HasSuffix(raw, thumb) || side == "right" && !strings.HasPrefix(raw, thumb) {
+					t.Fatalf("thumb not on pane-facing frame: %q", raw)
+				}
+			}
+			if !found {
+				t.Fatal("no scroll thumb")
+			}
+			if !m.SidebarWheel(g.Content.X, band[0]+1, false) || m.SidebarScrollT == 0 {
+				t.Fatal("wheel did not scroll rendered section")
+			}
+			before := m.SidebarScrollT
+			if !m.SidebarWheel(g.Band.X, band[0]+1, false) || m.SidebarScrollT != before {
+				t.Fatal("margin wheel changed section")
+			}
+			for _, hit := range m.SidebarHits {
+				if hit.Kind == sidebarRowCollapse || hit.Kind == sidebarRowFiles {
+					if hit.Y0 != g.Content.Y+g.Content.H-1 {
+						t.Fatalf("footer is not on last content row: %+v", hit)
+					}
+				}
+			}
+		})
+	}
+}
+
+func TestSidebarDetachedShortFallbackKeepsTerminalReachable(t *testing.T) {
+	for height := 5; height <= 12; height++ {
+		m := detachedRail(t, 120, height, "left")
+		if h := m.ViewUsableHeight(); h != 5 && h != 6 {
+			continue
+		}
+		m.Settings.SidebarSections = "terminals"
+		m.Windows = []*terminal.Window{{ID: "one", CustomName: "visible-terminal", Workspace: 1}}
+		m.sidebarPanelLines()
+		found := false
+		for _, hit := range m.SidebarHits {
+			found = found || hit.Kind == sidebarRowWindow && hit.WindowID == "one"
+		}
+		if !found {
+			t.Errorf("usable height %d hid the only terminal", m.ViewUsableHeight())
+		}
+	}
+}
+
+func TestSidebarDetachedFitsSizesAndASCII(t *testing.T) {
+	for _, width := range []int{30, 40, 51, 80, 120} {
+		for height := 3; height < 12; height++ {
+			m := detachedRail(t, width, height, "left")
+			m.Settings.UseASCIIOnly = true
+			lines, w := m.sidebarPanelLines()
+			if w == 0 {
+				continue
+			}
+			g := m.railGeometry()
+			if len(lines) != g.Frame.H {
+				t.Fatalf("size %dx%d frame height %d, want %d", width, height, len(lines), g.Frame.H)
+			}
+			for _, line := range lines {
+				if lipgloss.Width(line) != g.Frame.W {
+					t.Fatalf("size %dx%d width %d, want %d", width, height, lipgloss.Width(line), g.Frame.W)
+				}
+			}
+			if g.Detached && (!strings.HasPrefix(ansi.Strip(lines[0]), "+") || !strings.HasSuffix(ansi.Strip(lines[len(lines)-1]), "+")) {
+				t.Fatal("missing ASCII frame")
+			}
+			for _, hit := range m.SidebarHits {
+				if !g.Band.contains(hit.X0, hit.Y0) || !g.Band.contains(hit.X1-1, hit.Y1-1) {
+					t.Fatalf("hit outside band at %dx%d: %+v", width, height, hit)
+				}
+			}
+		}
+	}
+}
