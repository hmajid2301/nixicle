+)
+
+func detachedRail(t *testing.T, width, height int, side string) *OS {
+	t.Helper()
+	m := sidebarTestOS(t, width, height, side)
+	cfg := config.DefaultConfig()
+	if err := toml.Unmarshal([]byte("[appearance.sidebar]\nframe = 'detached'\nposition = '"+side+"'\n"), cfg); err != nil {
+		t.Fatal(err)
+	}
+	config.ApplyAppearanceConfig(cfg, &m.Settings)
+	return m
+}
+
+func TestSidebarDetachedFrame(t *testing.T) {
+	for _, side := range []string{"left", "right"} {
+		t.Run(side, func(t *testing.T) {
+			m := detachedRail(t, 120, 40, side)
+			lines, w := m.sidebarPanelLines()
+			x := sidebarEdgeX(m.legacySidebarEdge(), w, m.GetRenderWidth())
+			top := m.viewReserve().Top
+			if len(lines) != m.ViewUsableHeight()-2 {
+				t.Fatalf("frame height = %d, want %d", len(lines), m.ViewUsableHeight()-2)
+			}
+			for i, line := range lines {
+				if lipgloss.Width(line) != w-2 {
+					t.Fatalf("line %d width = %d, want %d", i, lipgloss.Width(line), w-2)
+				}
+			}
+			if !strings.HasPrefix(ansi.Strip(lines[0]), "╭") || !strings.HasSuffix(ansi.Strip(lines[len(lines)-1]), "╯") {
+				t.Fatal("missing rounded frame")
+			}
+			if len(m.SidebarHits) == 0 {
+				t.Fatal("no row hits")
+			}
+			for _, h := range m.SidebarHits {
+				if h.X0 < x+2 || h.X1 > x+w-2 || h.Y0 < top+2 || h.Y1 > top+m.ViewUsableHeight()-2 {
+					t.Fatalf("hit outside inner content: %+v", h)
+				}
+				if got, ok := m.sidebarRowAt(h.X0, h.Y0); !ok || got.Kind != h.Kind {
+					t.Fatalf("unreachable hit: %+v", h)
+				}
+			}
+			for _, p := range [][2]int{{x, top + 5}, {x + w - 1, top + 5}, {x + 3, top}, {x + 3, top + m.ViewUsableHeight() - 1}} {
+				if !m.SidebarClick(p[0], p[1], false) {
+					t.Fatal("margin press leaked")
+				}
+				if m.SidebarFocused || m.SidebarEdge.Active {
+					t.Fatal("margin press activated rail")
+				}
+				if !m.SidebarMotion(p[0], p[1]) || m.SidebarHoverActive {
+					t.Fatal("margin motion should be consumed without hover")
+				}
+			}
+			edgeX := x + w - 2
+			if side == "right" {
+				edgeX = x + 1
+			}
+			if !m.sidebarOnEdge(edgeX) || m.sidebarOnEdge(x+w-1) {
+				t.Fatal("resize edge does not match frame")
+			}
+			before := m.sidebarSignature()
+			config.ApplyAppearanceConfig(config.DefaultConfig(), &m.Settings)
+			if m.sidebarSignature() == before {
+				t.Fatal("frame omitted from cache signature")
+			}
+		})
+	}
+}
+
+func TestSidebarDetachedGlyphAndShortFallback(t *testing.T) {
+	for _, size := range [][2]int{{51, 37}, {120, 4}} {
+		m := detachedRail(t, size[0], size[1], "left")
+		lines, w := m.sidebarPanelLines()
+		if len(lines) != m.ViewUsableHeight() {
