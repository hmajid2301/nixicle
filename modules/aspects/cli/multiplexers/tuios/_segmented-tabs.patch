@@ -0,0 +1,109 @@
+package app
+
+import (
+	"image/color"
+	"strings"
+	"testing"
+
+	"charm.land/lipgloss/v2"
+	"github.com/Gaurav-Gosain/tuios/internal/config"
+	"github.com/Gaurav-Gosain/tuios/internal/overlay"
+	uv "github.com/charmbracelet/ultraviolet"
+	"tuios.dev/vt"
+)
+
+func TestSegmentedDockTabUsesSeparateIconAndLabelGrounds(t *testing.T) {
+	m := pillCapsOS(t, 160, map[int]string{1: "code"}, 1)
+	pal := overlay.Palette{
+		Canvas: lipgloss.Color("#11111b"), Surface: lipgloss.Color("#181825"),
+		Panel: lipgloss.Color("#313244"), Accent: lipgloss.Color("#b4befe"),
+		Fg: lipgloss.Color("#cdd6f4"), FgDim: lipgloss.Color("#bac2de"), PillFg: lipgloss.Color("#11111b"),
+	}
+	same := func(a, b color.Color) bool {
+		if a == nil || b == nil {
+			return a == b
+		}
+		ar, ag, ab, aa := a.RGBA()
+		br, bg, bb, ba := b.RGBA()
+		return ar == br && ag == bg && ab == bb && aa == ba
+	}
+	for _, active := range []bool{false, true} {
+		for _, dragged := range []bool{false, true} {
+			for _, attention := range []bool{false, true} {
+				cfg := config.DockTabsConfig{Style: "segmented", AttentionFg: "#f9e2af"}
+				drawn := m.dockTab(&cfg, "1 code", active, dragged, attention, pal, 1)
+				if got := lipgloss.Width(drawn); got != 10 {
+					t.Fatalf("width = %d, want 10", got)
+				}
+				term := vt.New(12, 1)
+				_, _ = term.Write([]byte(drawn))
+				wantGround := pal.Panel
+				if dragged {
+					wantGround = pal.Surface
+				}
+				if !same(term.CellAt(2, 0).Style.Bg, pal.Accent) {
+					t.Error("icon does not have accent background")
+				}
+				if !same(term.CellAt(4, 0).Style.Bg, wantGround) {
+					t.Error("label does not have its own background")
+				}
+				if !same(term.CellAt(0, 0).Style.Fg, pal.Accent) || !same(term.CellAt(9, 0).Style.Fg, wantGround) {
+					t.Error("outer caps do not match their segments")
+				}
+				if bold := term.CellAt(4, 0).Style.Attrs&uv.AttrBold != 0; bold != active {
+					t.Error("label emphasis does not identify the active workspace")
+				}
+				if attention && !active && !same(term.CellAt(4, 0).Style.Fg, lipgloss.Color("#f9e2af")) {
+					t.Error("inactive attention ink was lost")
+				}
+			}
+		}
+	}
+}
+
+func TestSegmentedDockTabFallsBackWithoutTwoTokensOrColor(t *testing.T) {
+	m := pillCapsOS(t, 160, map[int]string{1: "code"}, 1)
+	pal := m.groundUI()
+	cfg := config.DockTabsConfig{Style: "segmented"}
+	for _, label := range []string{"", "+", "code", " code", "1 "} {
+		if got, want := m.dockTab(&cfg, label, true, false, false, pal, 1), workspacePill(label, true, false, &cfg, pal, &m.Settings, nil); got != want {
+			t.Errorf("%q did not fall back to an ordinary pill", label)
+		}
+	}
+	m.Settings.UseASCIIOnly = true
+	if got, want := m.dockTab(&cfg, "1 code", true, false, false, pal, 1), workspacePill("1 code", true, false, &cfg, pal, &m.Settings, nil); got != want {
+		t.Error("ASCII output did not preserve the ordinary pill")
+	}
+	m.Settings.UseASCIIOnly = false
+	pal.Panel, pal.Surface = overlay.NoColor, overlay.NoColor
+	if got, want := m.dockTab(&cfg, "1 code", true, false, false, pal, 1), workspacePill("1 code", true, false, &cfg, pal, &m.Settings, nil); got != want {
+		t.Error("no-color output did not preserve the ordinary pill")
+	}
+}
+
+func TestSegmentedDockTabKeepsUnicodeAndNarrowHitGeometry(t *testing.T) {
+	for _, width := range []int{40, 80, 160} {
+		m := pillCapsOS(t, width, map[int]string{1: "code", 2: "日本語", 3: "review"}, 1, 2, 3)
+		m.Settings.DockWorkspaceTabFormat = "{icon}  {name}"
+		m.UserConfig = &config.UserConfig{}
+		m.UserConfig.Dock.Tabs = config.DockTabsConfig{Style: "segmented", NumberGlyphs: []string{"", "", "󰚩"}}
+		layout := m.CalculateDockLayout()
+		drawn := m.renderDockWorkspaceStrip(layout.WorkspaceStrip, 0)
+		if got := lipgloss.Width(drawn); got != layout.WorkspaceStrip.Width {
+			t.Errorf("%d-column layout planned %d but drew %d", width, layout.WorkspaceStrip.Width, got)
+		}
+		for _, hit := range m.dockWorkspaceHits {
+			if hit.Workspace == 0 {
+				continue
+			}
+			if m.DockWorkspaceAt(hit.X0, hit.Y) != hit.Workspace || m.DockWorkspaceAt(hit.X1-1, hit.Y) != hit.Workspace {
+				t.Error("pill edges are not clickable")
+			}
+		}
+		for _, tab := range layout.WorkspaceStrip.Pills {
+			if !strings.Contains(stripANSIForTrace(drawn), tab.Label) {
+				t.Errorf("planned label %q was clipped", tab.Label)
+			}
+		}
+	}
+}
