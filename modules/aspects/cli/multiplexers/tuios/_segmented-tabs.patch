+func segmentedWorkspaceTab(label string, active, dragged bool, t *config.DockTabsConfig, pal overlay.Palette, s *config.Settings, ink, accent color.Color) string {
+	prefix, text, split := strings.Cut(label, " ")
+	ground := pal.Panel
+	if dragged {
+		ground = pal.Surface
+	}
+	lc, rc := s.GetDockWorkspaceCapLeft(), s.GetDockWorkspaceCapRight()
+	if !split || prefix == "" || strings.TrimSpace(text) == "" || lc == "" || rc == "" || overlay.IsNoColor(ground) || overlay.IsNoColor(pal.Accent) {
+		return workspacePill(label, active, dragged, t, pal, s, ink)
+	}
+	fg := pal.Fg
+	if ink != nil {
+		fg = ink
+	}
+	icon := sidebarStyle(accent, theme.Readable(pal.PillFg, accent)).Bold(true)
+	body := sidebarStyle(ground, theme.Readable(fg, ground)).Bold(active)
+	left := lipgloss.NewStyle().Foreground(accent).Render(lc)
+	right := lipgloss.NewStyle().Foreground(ground).Render(rc)
+	return left + icon.Render(" "+prefix+" ") + body.Render(text+" ") + right
+}
+
