@@ -0,0 +1,31 @@
+package config
+
+import "testing"
+
+func TestSegmentedDockCapColorsValidateAndRoundTrip(t *testing.T) {
+	for _, value := range []string{`[]`, `["#b4befe","#a6e3a1"]`} {
+		cfg := DefaultConfig()
+		if err := SetLookValue(cfg, "dock.tabs.cap_colors", value); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := ParseLook([]byte("look = 1\n[dock.tabs]\nstyle = \"segmented\"\ncap_colors = " + value + "\n")); err != nil {
+			t.Fatal(err)
+		}
+	}
+	for _, value := range []string{`["invalid"]`, `[""]`, `["#ffffff\u001b"]`, `["#ffffff","#ffffff","#ffffff","#ffffff","#ffffff","#ffffff","#ffffff","#ffffff","#ffffff","#ffffff"]`} {
+		cfg := DefaultConfig()
+		if err := SetLookValue(cfg, "dock.tabs.cap_colors", value); err == nil {
+			t.Errorf("accepted %s", value)
+		}
+		if _, err := ParseLook([]byte("look = 1\n[dock.tabs]\ncap_colors = " + value + "\n")); err == nil {
+			t.Errorf("look accepted %s", value)
+		}
+	}
+	cfg := DefaultConfig()
+	cfg.Dock.Tabs.CapColors = []string{"invalid"}
+	result := &ValidationResult{}
+	validateDock(cfg, result)
+	if len(result.Warnings) == 0 {
+		t.Error("invalid raw config colour not reported")
+	}
+}
