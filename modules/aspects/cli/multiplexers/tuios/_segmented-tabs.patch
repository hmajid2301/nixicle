+package config
+
+import "testing"
+
+func TestCommandPaletteDensityOption(t *testing.T) {
+	const path = "appearance.palette_density"
+	cfg := DefaultConfig()
+	if got, ok := GetOptionValue(cfg, path); !ok || got != "compact" {
+		t.Fatalf("default = %q, registered = %v; want compact", got, ok)
+	}
+	for _, value := range []string{"roomy", "compact"} {
+		if err := SetLookValue(cfg, path, value); err != nil {
+			t.Fatal(err)
+		}
+		if cfg.Appearance.CommandPaletteDensity != value {
+			t.Fatalf("density = %q, want %q", cfg.Appearance.CommandPaletteDensity, value)
+		}
+	}
+	if err := SetOptionValue(cfg, path, "spacious"); err == nil {
+		t.Fatal("accepted invalid density")
+	}
+	if cfg.Appearance.CommandPaletteDensity != "compact" {
+		t.Fatal("invalid value changed density")
+	}
+}
