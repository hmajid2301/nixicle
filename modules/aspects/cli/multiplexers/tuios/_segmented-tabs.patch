+++ b/internal/app/sidebar_detached_geometry_test.go
@@ -0,0 +1,113 @@
+package app
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/Gaurav-Gosain/tuios/internal/config"
+	"github.com/charmbracelet/x/ansi"
+)
+
+func TestSidebarDetachedSplitOrigin(t *testing.T) {
+	m := detachedRail(t, 120, 40, "left")
+	m.sidebarPanelLines()
+	if !m.sidebarSplitGeom.Valid {
+		t.Fatal("no divider")
+	}
+	m.sidebarSplit.Active = true
+	y := m.railGeometry().Content.Y + 12
+	want := m.sidebarSplitGeom.sidebarSplitShareFor(12)
+	m.SidebarSplitMotion(3, y)
+	if m.SidebarSectionSplit != want {
+		t.Fatalf("split = %d, want %d", m.SidebarSectionSplit, want)
+	}
+}
+
+func TestSidebarDetachedUsesRoundedSides(t *testing.T) {
+	m := detachedRail(t, 120, 40, "left")
+	m.Settings.BorderStyle = "double"
+	lines, _ := m.sidebarPanelLines()
+	if line := ansi.Strip(lines[1]); !strings.HasPrefix(line, "│") || !strings.HasSuffix(line, "│") {
+		t.Fatalf("detached rounded sides = %q", line)
+	}
+}
+
+func TestSidebarDetachedLayerAndFooter(t *testing.T) {
+	for _, side := range []string{"left", "right"} {
+		t.Run(side, func(t *testing.T) {
+			m := detachedRail(t, 120, 40, side)
+			width := m.GetSidebarWidth()
+			contentWidth := m.GetContentWidth()
+			g := m.railGeometry()
+			layer := m.renderSidebar()
+			if m.GetSidebarWidth() != width || m.GetContentWidth() != contentWidth {
+				t.Fatal("frame changed reservation")
+			}
+			if layer.GetX() != g.Frame.X || layer.GetY() != g.Frame.Y {
+				t.Fatal("layer origin disagrees with geometry")
+			}
+			for _, hit := range m.SidebarHits {
+				if hit.Kind != sidebarRowCollapse {
+					continue
+				}
+				m.SidebarMotion(hit.X0, hit.Y0)
+				if !m.SidebarHoverActive {
+					t.Fatal("footer not hoverable")
+				}
+				m.sidebarPanelLines()
+				if !m.SidebarClick(hit.X0, hit.Y0, false) || !m.SidebarCollapsed {
+					t.Fatal("footer click did not collapse")
+				}
+				return
+			}
+			t.Fatal("no collapse control")
+		})
+	}
+}
+
+func TestSidebarDetachedResizeTracksFrame(t *testing.T) {
+	for _, side := range []string{"left", "right"} {
+		t.Run(side, func(t *testing.T) {
+			m := detachedRail(t, 120, 40, side)
+			g := m.railGeometry()
+			x := g.Frame.X + g.Frame.W - 1
+			if side == "right" {
+				x = g.Frame.X
+			}
+			m.SidebarClick(x, g.Content.Y, false)
+			if !m.SidebarEdge.Active {
+				t.Fatal("frame edge did not arm resize")
+			}
+			m.SidebarEdgeMotion(x, g.Content.Y)
+			if m.GetSidebarWidth() != g.Band.W {
+				t.Fatalf("stationary resize changed reservation: %d -> %d", g.Band.W, m.GetSidebarWidth())
+			}
+		})
+	}
+}
+
+func TestSidebarDetachedSecondaryGeometry(t *testing.T) {
+	m := detachedRail(t, 120, 40, "left")
+	m.UserConfig = config.DefaultConfig()
+	on := true
+	m.UserConfig.Appearance.Sidebar.Right = &config.SidebarEdgeConfig{Enabled: &on, Width: 24}
+	layer := m.renderSecondarySidebar()
+	if layer == nil {
+		t.Fatal("no secondary rail")
+	}
+	g := m.sidebarGeometryFor(sidebarRight, m.secondarySidebarWidth())
+	if layer.GetX() != g.Frame.X || layer.GetY() != g.Frame.Y {
+		t.Fatal("secondary layer origin mismatch")
+	}
+	if len(m.secondarySidebarHits) == 0 {
+		t.Fatal("no secondary hits")
+	}
+	for _, hit := range m.secondarySidebarHits {
+		if !g.Content.contains(hit.X0, hit.Y0) || !g.Content.contains(hit.X1-1, hit.Y1-1) {
+			t.Fatalf("secondary hit outside content: %+v", hit)
+		}
+	}
+	if !m.SidebarMotion(g.Band.X, g.Content.Y) || m.secondaryRailView.hover {
+		t.Fatal("secondary margin hover activated")
+	}
+}
