{
  "models": {
    "default": "anthropic/claude-sonnet-4-5",
    "agents": {
      "planner": "anthropic/claude-opus-4-6",
      "scout": "anthropic/claude-haiku-4-5"
    }
  },
  "widget": {
    "collapsed": false
  },
  "stageTimeoutMinutes": 30,
  "panes": {
    "mode": "grouped",
    "direction": "right",
    "maxPerTab": 4
  },
  "persistent": {
    "maxAgents": 3
  },
  "supervision": {
    "stallGraceMs": 5000
  },
  "btw": {
    "tools": ["read", "grep", "find", "ls"]
  }
}
