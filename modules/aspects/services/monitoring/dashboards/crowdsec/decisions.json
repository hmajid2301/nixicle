        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"crowdsec\"} |= \"alert :\" | json | line_format \"{{.MESSAGE}}\" | pattern \"<_> alert : <scenario> by ip <ip> (<_>)\" [24h]))",
