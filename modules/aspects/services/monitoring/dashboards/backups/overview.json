{
  "uid": "nixicle-backups",
  "title": "Backup Health",
  "description": "Provisioned homelab health. NO DATA means unknown, never healthy.",
  "tags": [
    "nixicle",
    "homelab",
    "health"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "links": [
    {
      "title": "Homelab Health",
      "type": "link",
      "url": "/d/nixicle-health",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "NAS Storage Health",
      "type": "link",
      "url": "/d/nixicle-storage",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Critical Service Availability",
      "type": "link",
      "url": "/d/nixicle-availability",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Monitoring Pipeline Health",
      "type": "link",
      "url": "/d/nixicle-monitoring-health",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(up{job=\"nodes\"}, host)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "title": "Age of last successful job",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "NO DATA",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - ((restic_backup_last_success_timestamp_seconds{host=~\"$host\"} and on(host,backup) restic_backup_expected) or on(host,backup) (0 * restic_backup_expected{host=~\"$host\"}))",
          "legendFormat": "{{host}} {{backup}}",
          "instant": true,
          "range": false
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Last successful job completion",
      "type": "stat",
      "description": "Zero means no successful completion has been recorded. Timestamp updates only after backup, configured pruning and checks succeed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso",
          "noValue": "NO DATA",
          "mappings": [
            { "type": "value", "options": { "0": { "text": "NEVER", "color": "red" } } }
          ],
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * ((restic_backup_last_success_timestamp_seconds{host=~\"$host\"} and on(host,backup) restic_backup_expected) or on(host,backup) (0 * restic_backup_expected{host=~\"$host\"}))",
          "legendFormat": "{{host}} {{backup}}",
          "instant": true,
          "range": false
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Successful job duration",
      "type": "timeseries",
      "description": "Includes preparation, lock waits, backup, configured pruning and checks; failed/skipped attempts do not overwrite the last success.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "NO DATA",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "restic_backup_duration_seconds{host=~\"$host\"} and on(host,backup) restic_backup_expected",
          "legendFormat": "{{host}} {{backup}}",
          "instant": false,
          "range": true
        }
      ],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Failed backup units",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_systemd_unit_state{host=~\"$host\",name=~\"restic-backups-.*[.]service\",state=\"failed\"}",
          "legendFormat": "{{host}} {{name}}",
          "instant": false,
          "range": true
        }
      ],
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Expected backup timers active",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CHECK",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(label_replace(restic_backup_expected{host=~\"$host\"}, \"name\", \"restic-backups-$1.timer\", \"backup\", \"(.+)\") * on(host,name) group_left() node_systemd_unit_state{state=\"active\"}) or on(host,backup) (0 * label_replace(restic_backup_expected{host=~\"$host\"}, \"name\", \"restic-backups-$1.timer\", \"backup\", \"(.+)\"))",
          "legendFormat": "{{host}} {{backup}}",
          "instant": true,
          "range": false
        }
      ],
      "id": 5,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Expected jobs missing success history",
      "type": "stat",
      "description": "An empty result means all expected jobs have reported at least once. It does not prove a repository check or restore test has been performed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "restic_backup_expected{host=~\"$host\"} unless on(host,backup) restic_backup_last_success_timestamp_seconds",
          "legendFormat": "{{host}} {{backup}}",
          "instant": true,
          "range": false
        }
      ],
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      }
    }
  ]
}
