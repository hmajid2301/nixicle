        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - (homelab_zfs_scrub_last_completed_timestamp_seconds or on(host,pool) (0 * zfs_pool_health{host=\"nas\",pool=\"main\"}))",
          "legendFormat": "{{pool}}",
          "instant": true,
          "range": false
        }
      ],
      "id": 8,
      "gridPos": {
