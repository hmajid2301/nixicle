{
  "uid": "nixicle-storage",
  "title": "NAS Storage Health",
  "description": "Provisioned homelab health. NO DATA means unknown, never healthy.",
  "tags": [
    "nixicle",
    "homelab",
    "health"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "links": [
    {
      "title": "Homelab Health",
      "type": "link",
      "url": "/d/nixicle-health",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Backup Health",
      "type": "link",
      "url": "/d/nixicle-backups",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Critical Service Availability",
      "type": "link",
      "url": "/d/nixicle-availability",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Monitoring Pipeline Health",
      "type": "link",
      "url": "/d/nixicle-monitoring-health",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "title": "ZFS pool health (0 = ONLINE)",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "OK",
                  "color": "green"
                },
                "1": {
                  "text": "CHECK",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "zfs_pool_health{host=\"nas\"}",
          "legendFormat": "{{pool}}",
          "instant": true,
          "range": false
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "title": "Pool allocated",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "NO DATA",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * zfs_pool_allocated_bytes{host=\"nas\"} / zfs_pool_size_bytes{host=\"nas\"}",
          "legendFormat": "{{pool}}",
          "instant": false,
          "range": true
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
