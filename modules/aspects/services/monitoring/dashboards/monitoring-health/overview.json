{
  "uid": "nixicle-monitoring-health",
  "title": "Monitoring Pipeline Health",
  "description": "Provisioned homelab health. NO DATA means unknown, never healthy.",
  "tags": [
    "nixicle",
    "homelab",
    "health"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "links": [
    {
      "title": "Homelab Health",
      "type": "link",
      "url": "/d/nixicle-health",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "NAS Storage Health",
      "type": "link",
      "url": "/d/nixicle-storage",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Backup Health",
      "type": "link",
      "url": "/d/nixicle-backups",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Critical Service Availability",
      "type": "link",
      "url": "/d/nixicle-availability",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "title": "Monitoring exporters",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "NO DATA",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "CHECK",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"prometheus|grafana|loki|tempo|otel-internal|otel-collector\"}",
          "legendFormat": "{{job}}",
          "instant": true,
          "range": false
        }
      ],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
